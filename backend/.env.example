# ──────────────────────────────────────────────────────────────────────────
# Trend Intelligence Dashboard — .env şablonu
#
# Kurulum:
# 1. Bu dosyayı .env olarak kopyalayın:    cp .env.example .env
# 2. Aşağıdaki ZORUNLU alanları doldurun
# 3. Backend'i başlatın
# 4. Tarayıcıda Ayarlar sayfasından AI ve diğer entegrasyonları yapılandırın
# ──────────────────────────────────────────────────────────────────────────

# ── ZORUNLU: Auth ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=degistir-beni-guvenli-bir-sifreye
JWT_SECRET=cok-uzun-rastgele-bir-string-uretip-buraya-yapistir
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=720

# ── ZORUNLU: Database ─────────────────────────────────────────────────────
DATABASE_URL=sqlite:///../data/trends.db

# ── Pytrends (Google Trends) — varsayılanlar TR ───────────────────────────
PYTRENDS_GEO=TR
PYTRENDS_HL=tr-TR
PYTRENDS_TIMEFRAME=today 1-m
REQUEST_DELAY_SECONDS=2
MAX_RETRIES=3

# ── Günlük Otomatik Toplama (cron) ────────────────────────────────────────
COLLECT_HOUR=3
COLLECT_MINUTE=0
TIMEZONE=Europe/Istanbul

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── OPSİYONEL: AI (en az biri olmalı, AI özellikleri için) ────────────────
# https://console.anthropic.com  (önerilen — Claude)
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys  (alternatif — ChatGPT)
OPENAI_API_KEY=
AI_PROVIDER=anthropic

# ── OPSİYONEL: Google Ads API (gerçek aylık arama hacmi) ──────────────────
# Detaylı kurulum: README.md → "Google Ads Setup"
# 1. Google Cloud Console'da proje oluştur, Google Ads API aktive et
# 2. OAuth Client ID (Desktop app) oluştur → client_id + client_secret
# 3. Google Ads UI → API Center'dan developer token al
# 4. Manager (MCC) hesap aç (Test mode kabul edilmez)
# 5. backend/setup_google_ads.py çalıştır → refresh_token üretir
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_LANGUAGE_ID=1055
GOOGLE_ADS_GEO_TARGET_ID=2792
GOOGLE_ADS_API_VERSION=v21

# ── OPSİYONEL: Google Search Console (gerçek pozisyon/CTR/tıklama) ────────
# Aynı Google Ads OAuth'u kullanır (webmasters.readonly scope eklenir)
# 1. Search Console'da siten doğrulanmış olmalı
# 2. backend/reauth_oauth.py çalıştır → yeni scope ile token yenile
# 3. Tarayıcıda Genel Bakış → Search Console kart → "Sitelerimi Listele"
SEARCH_CONSOLE_SITE_URL=

# ── OPSİYONEL: İçerik Boşluk Analizi için site dosya yolu ─────────────────
# Sitenizin lokal kaynak kodu klasörü (Next.js/Remix)
# UI'dan Ayarlar → Site sekmesinden de değiştirilebilir
KOD_ORG_PATH=
